## Parameters for this instance.

#### KNOWLEDGE BASE PARAMETERS
# Base path to markdown knowledge files to ingest.
KNOWLEDGE_PATH=/opt/rag/knowledge/default

#### EMBEDDER AND LLM SERVICES
OLLAMA_MODEL_CHAT=qwen2.5:7b
OLLAMA_MODEL_EMBEDDING=yxchia/multilingual-e5-base
OLLAMA_URL=http://localhost:11434

#### STORAGE CONFIGURATION
# Use file storage for simple single-server installs.
RAG_VECTORSTORE_PATH=/var/lib/rag/default/rag.chunks.jsonl
RAG_VECTORSTORE_TYPE=file

# Use Qdrant for persistent vector storage shared outside the local filesystem.
# Set RAG_VECTORSTORE_TYPE=qdrant and fill these values when using Qdrant.
QDRANT_API_KEY=
QDRANT_COLLECTION=rag_chunks
QDRANT_URL=

#### RAG SERVICE PARAMETERS
RAG_HTTP_ADDR=127.0.0.1:8080
# Optional override; keep prompt content private (change at your own risk).
# RAG_PROMPT_OVERRIDE=

# Set an API key to require clients to authenticate. Leave empty to disable API key auth.
RAG_API_KEY=
RAG_LOG_LEVEL=info
RAG_LICENSE=PASTE_LICENSE_HERE

#### INGESTING PARAMETERS
RAG_CHUNK_INCLUDE_HEADING=true
RAG_CHUNK_MAX_CHARS=2000
RAG_CHUNK_MAX_WORDS=200
RAG_CHUNK_MIN_WORDS=0
RAG_CHUNK_OVERLAP_WORDS=20
RAG_EMBED_MAX_TOKENS=512
RAG_HISTORY_MAX_TURNS=6
RAG_INGEST_STRICT=false

#### ASKING PARAMETERS
# RAG_ASK_DEFAULT_STREAM=true
RAG_ASK_DEFAULT_THINK=false
RAG_RELATED_DOCS_LIMIT=3
RAG_SIMILARITY_THRESHOLD=0.2
RAG_SOURCES_LINKS_LIMIT=5
RAG_TOPK=16
