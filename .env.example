# Configuration reference for a Linux installation.
#
# The installer writes this file to /etc/rag/<instance>/rag.env.
#
# Convention: active (uncommented) lines are required or provided by you;
# commented lines are optional and show their defaults. When a value is required
# only in a particular configuration, the comment above says so.

# ── LLM roles ───────────────────────────────────────────────────────────────
# Every role has its own base URL, key, model, and timeout, so a role can move
# to another provider without touching the rest. All roles speak the OpenAI
# protocol. Only the models are required; answers also need an explicit base
# URL, because answering must never silently fall back to a local provider.

# Embeddings: keep them on local Ollama, where they are free.
LLM_EMBED_MODEL=yxchia/multilingual-e5-base
# LLM_EMBED_BASE_URL=http://localhost:11434/v1
# LLM_EMBED_API_KEY=
# LLM_EMBED_TIMEOUT_SECONDS=60

# Answers: local Ollama by default. Any OpenAI-compatible provider works;
# for DeepSeek set LLM_ANSWER_BASE_URL=https://api.deepseek.com together with
# LLM_ANSWER_MODEL=deepseek-chat.
LLM_ANSWER_MODEL=qwen2.5:7b
LLM_ANSWER_BASE_URL=http://localhost:11434/v1
# Required only by providers that authenticate. Leave empty for local models.
# LLM_ANSWER_API_KEY=
# LLM_ANSWER_TIMEOUT_SECONDS=60
# Sampling temperature. Omitted from requests when not set.
# Reasoning models (name containing "reason") ignore this value.
# LLM_ANSWER_TEMPERATURE=0.3
# Maximum answer tokens. Omitted from requests when 0 (provider default).
# Capping the answer also reduces latency.
# LLM_ANSWER_MAX_TOKENS=1024

# Classification: a small local model keeps injection detection free.
# RAG_INTENT_CLASSIFIER_ENABLED=false
# Model required when classification is enabled.
# LLM_CLASSIFIER_MODEL=qwen2.5:3b
# LLM_CLASSIFIER_BASE_URL=http://localhost:11434/v1
# LLM_CLASSIFIER_API_KEY=
# LLM_CLASSIFIER_TIMEOUT_SECONDS=15
# Custom response returned when an injection is detected.
# Default: "This request cannot be processed. Please rephrase your question."
# Localize this value for the target audience.
# RAG_INJECTION_GUARD_ANSWER=Request blocked due to security policy.

# ── Ingest & Chunking ───────────────────────────────────────────────────────

# Path to the knowledge base directory containing Markdown documents to ingest.
KNOWLEDGE_PATH=/opt/rag/knowledge/default

# Maximum characters per chunk. Default: 2000.
# RAG_CHUNK_MAX_CHARS=2000

# Maximum words per chunk. Default: 200.
# RAG_CHUNK_MAX_WORDS=200

# Overlapping words between adjacent chunks. Default: 20.
# RAG_CHUNK_OVERLAP_WORDS=20

# Minimum words for a chunk to be kept (below this = discarded). Default: 0.
# RAG_CHUNK_MIN_WORDS=0

# Include document heading in each chunk. Default: true.
# RAG_CHUNK_INCLUDE_HEADING=true

# Prefix each chunk with the document title and description from YAML front matter. Default: false.
# RAG_CHUNK_INCLUDE_DOC_PREFIX=false

# Fail on first ingest error instead of skipping. Default: false.
# RAG_INGEST_STRICT=false

# ── Retrieval ───────────────────────────────────────────────────────────────

# Max tokens per embedding request (controls truncation). Default: 512.
# RAG_EMBED_MAX_TOKENS=512

# Number of top chunks to retrieve for context.
RAG_TOPK=16

# Minimum cosine similarity score for a chunk to be relevant. Default: 0.2.
# RAG_SIMILARITY_THRESHOLD=0.2

# Max source links to include in answer.
RAG_SOURCES_LINKS_LIMIT=5

# Max related documents to fetch per document when retrieving. Default: 3.
# RAG_RELATED_DOCS_LIMIT=3

# ── Prompt & History ────────────────────────────────────────────────────────

# Max conversation history turns to include as context. Default: 6.
# RAG_HISTORY_MAX_TURNS=6

# Custom system prompt replacing the built-in one entirely.
# Keep prompt content private — value is hidden in logs.
# RAG_PROMPT_OVERRIDE=<custom prompt>

# Additional instructions appended to the system prompt (after override or default).
# Useful for integrations that only want to augment the prompt, not replace it.
# The built-in anti-injection hardening block is always appended after this
# value and cannot be disabled or reordered.
# RAG_PROMPT_EXTEND=<additional instructions>

# ── Answer safety ───────────────────────────────────────────────────────────

# Wrap retrieved chunks in <retrieved_context> tags and instruct the model to
# treat them as data, not instructions. Default: true.
# RAG_CONTEXT_GUARD=true

# Post-check that numbers, dates, URLs, and e-mails in the answer exist in the
# retrieved context or the question: "off", "warn" (default), or "enforce".
# "enforce" replaces the answer with a safe fallback and applies to
# non-streaming requests only; streamed answers are logged but not modified.
# RAG_GROUNDING_CHECK=warn

# Answer returned when no retrieved chunk passes the similarity threshold.
# Default: "No relevant documents found".
# RAG_NO_DOCS_ANSWER=No relevant documents found

# ── Vector Store ────────────────────────────────────────────────────────────

# Backend: "memory", "file", or "qdrant".
RAG_VECTORSTORE_TYPE=file

# File path for the "file" backend (JSONL format).
RAG_VECTORSTORE_PATH=/var/lib/rag/default/rag.chunks.jsonl

# Qdrant server URL. Required when type is "qdrant".
# QDRANT_URL=

# Qdrant API key.
# QDRANT_API_KEY=

# Qdrant collection name. Default: rag_chunks.
# QDRANT_COLLECTION=rag_chunks

# ── HTTP API & Licensing ────────────────────────────────────────────────────

# HTTP listen address.
RAG_HTTP_ADDR=127.0.0.1:8080

# Bearer token for API authentication (empty = no auth).
# RAG_API_KEY=changeme

# License token (EdDSA JWT) for plan enforcement.
RAG_LICENSE=PASTE_LICENSE_HERE

# ── Ask Defaults ────────────────────────────────────────────────────────────

# Default streaming behavior for /ask. Accepts "true" or "false".
# Not set = respect the per-request stream field.
# RAG_ASK_DEFAULT_STREAM=

# Default thinking mode for /ask. Accepts "true", "false", "none", or a
# reasoning effort level: "low", "medium", "high". "true" maps to "medium";
# "false" and "none" leave the effort to the provider and model.
# Not set = respect the per-request field.
# RAG_ASK_DEFAULT_THINK=

# ── Logging ─────────────────────────────────────────────────────────────────

# Log level: "info" (default) or "debug".
# RAG_LOG_LEVEL=info
